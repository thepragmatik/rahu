# Copy to .env (gitignored) and fill in. Never commit .env.
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# examples/live-local-systemone.json interpolates these three. `config validate`
# REFUSES to load the config while any of them is unset, and it names the
# missing one, so a partial fill is reported rather than silently defaulted.
#
# The decision model runs in YOUR local System One service, so this is whatever
# that service serves — it is not resolved here.
RAHU_DECISION_MODEL=
# The two generation models in pools.development. They must be real OpenRouter
# model ids; the shipped ready pool (Mistral Nemo, Qwen3-30B-A3B, gpt-oss-20b,
# Granite micro) is all under $0.05/1M input tokens. See config.local.json.
RAHU_FAST_MODEL=
RAHU_QUALITY_MODEL=